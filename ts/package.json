{
  "name": "trackplan",
  "version": "0.2.0",
  "description": "Type-safe analytics code generator. Turns one YAML tracking plan into TypeScript code so typos and missing event parameters become compile errors.",
  "keywords": [
    "analytics",
    "tracking-plan",
    "codegen",
    "typescript",
    "type-safety",
    "events",
    "cli"
  ],
  "license": "MIT",
  "author": "Ahmad Hussain <ahmadhussain0335@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ahmadhussain0335/trackplan.git",
    "directory": "ts"
  },
  "bugs": {
    "url": "https://github.com/Ahmadhussain0335/trackplan/issues"
  },
  "homepage": "https://github.com/Ahmadhussain0335/trackplan/tree/main/ts#readme",
  "type": "module",
  "bin": {
    "trackplan": "dist/bin.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.0",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.12"
  }
}
